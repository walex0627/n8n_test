    {
      "parameters": {
        "jsCode": "const bankRegex = /\\b(Bancolombia|Nequi|Nu|Nubank|Uala|Davivienda|Daviplata|PSE|Breebe|Transfiya)\\b/i;\n\nconst bankItems = items.filter(item => {\n  const snippet = item.json.snippet || \"\";\n  const subject = item.json.Subject || \"\";\n  return bankRegex.test(snippet) || bankRegex.test(subject);\n});\n\nreturn bankItems.map(item => {\n  const raw = item.json;\n  const snippet = raw.snippet || \"\";\n  const subject = raw.Subject || \"\";\n  const fullText = `${subject} ${snippet}`;\n\n  // 1. Extracción de Monto\n  const amountMatch = fullText.match(/(?:COP|\\$|valor|por|de)\\s*([\\d\\.,]{3,})/i);\n  let amount = 0;\n  if (amountMatch) {\n    let rawAmount = amountMatch[1].replace(/\\s/g, \"\");\n    if (rawAmount.includes(\",\") && rawAmount.includes(\".\")) {\n       rawAmount = rawAmount.replace(/\\./g, \"\").replace(\",\", \".\");\n    } else if (rawAmount.includes(\".\") && rawAmount.indexOf(\".\") !== rawAmount.lastIndexOf(\".\")) {\n       rawAmount = rawAmount.replace(/\\./g, \"\");\n    } else {\n       rawAmount = rawAmount.replace(\",\", \".\");\n    }\n    amount = parseFloat(rawAmount) || 0;\n  }\n\n  // 2. Clasificación de tipo y comercio\n  const transactionKeywords = /\\b(pago|compra|transferencia|recibiste|enviaste|adelanto|retiro|desembolso|PSE|Breebe|llave)\\b/i;\n  const isTransaction = amount > 0 || transactionKeywords.test(fullText);\n  \n  const merchantMatch = fullText.match(/(?:en|desde|a|de)\\s+(.+?)\\s+(?:con tu|el|desde|por|a las|el día|con nro|valor|en)/i);\n  let merchant = merchantMatch ? merchantMatch[1].trim().toUpperCase() : \"BANCO/SISTEMA\";\n\n  // 3. Fechas y Tiempos\n  const dateObj = new Date(parseInt(raw.internalDate));\n  const dateReadable = dateObj.toLocaleString(\"es-CO\", { timeZone: \"America/Bogota\" });\n\n  // 4. Asignación de Banco\n  let bankName = \"Otro\";\n  if (/Bancolombia/i.test(fullText)) bankName = \"Bancolombia\";\n  else if (/Nequi/i.test(fullText)) bankName = \"Nequi\";\n  else if (/Nu|Nubank/i.test(fullText)) bankName = \"Nu\";\n  else if (/Uala/i.test(fullText)) bankName = \"Ualá\";\n  else if (/Davivienda|Daviplata/i.test(fullText)) bankName = \"Davivienda/Daviplata\";\n  else if (/Breebe/i.test(fullText)) bankName = \"Breebe\";\n  else if (/PSE/i.test(fullText)) bankName = \"PSE\";\n\n  return {\n    json: {\n      id: raw.id,\n      threadId: raw.threadId,\n      bank: bankName,\n      subject: subject,\n      from: raw.From,\n      to: raw.To || \"walteralex0627@gmail.com\",\n      snippet: snippet,\n      merchant: merchant,\n      amount_cop: amount,\n      currency: amount > 0 ? \"COP\" : \"\",\n      tx_date: dateObj.toISOString().split('T')[0],\n      tx_time: dateObj.toTimeString().split(' ')[0],\n      internalDate_readable: dateReadable,\n      labels: JSON.stringify(raw.labels || []), // Lo pasamos como texto para el Excel\n      mimeType: raw.payload?.mimeType || \"text/plain\",\n      sizeEstimate: raw.sizeEstimate,\n      historyId: raw.historyId,\n      type: isTransaction ? \"transaction\" : \"notification\",\n      internalDate: raw.internalDate\n    }\n  };\n});"
      },
